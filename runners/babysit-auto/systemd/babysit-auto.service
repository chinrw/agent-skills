[Unit]
Description=One unattended /babysit-prs tick
Documentation=file:%h/Documents/play/agent-skills/runners/babysit-auto/README.md
# A background run is invisible unless something says so. Only real failures
# reach here: an idle or busy tick ends skipped (Result=exec-condition), which
# is not a failure.
# OnFailure=notify-me@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/play/stocks
Environment=BABYSIT_RUNNER=%h/Documents/play/agent-skills/runners/babysit-auto
Environment=PATH=%h/.nix-profile/bin:/run/current-system/sw/bin

# Nothing due, or a run already active -> the unit is skipped cleanly.
# ExecCondition treats exit 1..254 as "skip", which covers the gate's 10 (idle)
# and 13 (busy); the unit ends skipped (Result=exec-condition), which is not a
# failure, so OnFailure does not fire. This is the whole point of the runner: an idle tick costs three gh
# calls and no model turn; a busy tick costs a /proc scan and nothing else.
ExecCondition=/run/current-system/sw/bin/node ${BABYSIT_RUNNER}/tick-gate.mjs due --repo chinrw/stocks

# Only reached when work is due, and a failure here does mark the unit failed.
# The gate treats anything it cannot decide as due, so a skill whose marker or
# state contract moved gets pushed toward running and lands right here.
ExecStartPre=/run/current-system/sw/bin/node ${BABYSIT_RUNNER}/tick-gate.mjs contract
ExecStartPre=/run/current-system/sw/bin/mkdir -p %h/.claude/babysit-prs

# flock guards timer-against-timer; the gate's busy check above (exit 13,
# treated as skip) guards against a person driving /babysit-prs at a terminal,
# since the skill has no lock of its own. The kernel drops this lock on death,
# so a killed tick cannot block the next.
#
# The budget is enforced by timeout(1) inside the unit, not by TimeoutStartSec:
# systemd records its own timeout as Result=timeout, which SuccessExitStatus
# cannot reclassify, so a bounded run would be reported as a failure forever.
ExecStart=/run/current-system/sw/bin/flock -n -E 75 %h/.claude/babysit-prs/timer.lock \
    /run/current-system/sw/bin/timeout --signal=INT 3300 \
    /run/current-system/sw/bin/bash ${BABYSIT_RUNNER}/run-controller.sh

# 124: the wall-clock budget expired. 75: a previous tick still holds the lock.
# Both are ordinary outcomes — every PR's state lives in its GitHub status
# comment, and the next tick reconstructs it.
SuccessExitStatus=75 124
TimeoutStartSec=3600

Nice=10
