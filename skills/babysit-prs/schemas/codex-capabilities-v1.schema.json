{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "babysit-prs/codex-capabilities-v1",
  "title": "Codex companion capability probe (v1)",
  "description": "Written once per invocation by scripts/probe-codex-capabilities.mjs and reused by every Codex launch in that invocation. Requested efforts are normalized against acceptedEfforts BEFORE dispatch, so an unsupported tier is a preflight normalization rather than a failed task round.",
  "type": "object",
  "required": [
    "schemaVersion",
    "companionPath",
    "acceptedEfforts",
    "effortCeiling",
    "ambiguous",
    "probedAt",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "codexVersion": { "type": ["string", "null"], "maxLength": 128 },
    "companionPath": { "type": "string", "minLength": 1 },
    "companionVersion": { "type": ["string", "null"], "maxLength": 128 },
    "acceptedEfforts": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/effort" }
    },
    "effortCeiling": {
      "anyOf": [{ "$ref": "#/definitions/effort" }, { "type": "null" }]
    },
    "ambiguous": {
      "type": "boolean",
      "description": "true when the probe could not establish the accepted set, or when two inspection sources disagreed. Codex-dependent remote writes must be blocked rather than guessed."
    },
    "ambiguityReason": { "type": ["string", "null"], "maxLength": 2000 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["name", "ok"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "enum": ["declared-enum", "usage-text", "codex-cli-version"]
          },
          "ok": { "type": "boolean" },
          "efforts": {
            "type": ["array", "null"],
            "items": { "$ref": "#/definitions/effort" },
            "maxItems": 16
          },
          "detail": { "type": ["string", "null"], "maxLength": 2000 }
        }
      }
    },
    "probedAt": { "type": "string", "minLength": 20, "maxLength": 32 }
  },
  "definitions": {
    "effort": {
      "type": "string",
      "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max"]
    }
  }
}
