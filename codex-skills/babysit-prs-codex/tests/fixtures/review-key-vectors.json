{
  "$comment": "Executable review-key test vectors. Every field is COMPLETE — abbreviated hashes must never appear in a fixture, because an abbreviation cannot prove a byte contract.",
  "contract": {
    "policyVersion": "babysit-prs-v2",
    "encoding": "utf-8",
    "fieldOrder": ["policyVersion", "canonicalRepo", "pr", "headOid", "baseOid", "specHash"],
    "separator": "exactly one NUL (0x00) between adjacent fields",
    "leadingNul": false,
    "trailingNul": false,
    "finalNewline": false,
    "prNumber": "decimal, no sign, no padding, no whitespace",
    "oids": "full lowercase hex, 40 or 64 chars; abbreviations rejected",
    "specHashWhenAbsent": "the literal string \"none\"",
    "policyHash": "absent in v2; adding one under the same version string is forbidden"
  },
